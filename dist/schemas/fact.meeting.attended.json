{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "meeting.attended"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "description": "An actor id on the same event."
    },
    "response": {
      "type": "string",
      "enum": [
        "accepted",
        "declined",
        "tentative",
        "needs_action"
      ]
    },
    "organizer": {
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "actor",
    "response",
    "organizer"
  ],
  "additionalProperties": false
}
