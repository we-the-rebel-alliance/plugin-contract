{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "person.attribute"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "description": "An actor id on the same event."
    },
    "org": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "team": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  },
  "required": [
    "type",
    "actor"
  ],
  "additionalProperties": false,
  "description": "A person's attribute, from structured profile or directory data only: at least one of org, team or role."
}
