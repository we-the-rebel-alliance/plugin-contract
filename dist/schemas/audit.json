{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "person": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "manifestHash": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "string",
            "enum": [
              "all",
              "ask-changes",
              "read-only"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "accounts": {
                  "type": "string",
                  "enum": [
                    "optional",
                    "none"
                  ]
                },
                "private": {
                  "type": "boolean"
                },
                "cost": {
                  "type": "object",
                  "properties": {
                    "class": {
                      "type": "string",
                      "enum": [
                        "free",
                        "metered",
                        "billed"
                      ]
                    },
                    "units": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "per": {
                            "type": "string",
                            "minLength": 1
                          },
                          "usd": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "per",
                          "usd"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "class"
                  ],
                  "additionalProperties": false
                },
                "grants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consumer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "account": {
                        "type": "string",
                        "minLength": 1
                      },
                      "scope": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ]
                        }
                      },
                      "manifestHash": {
                        "type": "string",
                        "minLength": 1
                      },
                      "disabled": {
                        "type": "boolean"
                      },
                      "person": {
                        "type": "string",
                        "minLength": 1
                      },
                      "grantedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      },
                      "stale": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "consumer",
                      "account",
                      "scope",
                      "manifestHash",
                      "disabled",
                      "person",
                      "grantedAt"
                    ],
                    "additionalProperties": false,
                    "description": "One grant behind a source or an action, and the binding the person consented to."
                  }
                }
              },
              "required": [
                "id",
                "method",
                "operations",
                "accounts",
                "private",
                "cost",
                "grants"
              ],
              "additionalProperties": false
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "preview": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confirmation": {
                  "type": "string",
                  "enum": [
                    "required",
                    "optional"
                  ]
                },
                "grants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "consumer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "account": {
                        "type": "string",
                        "minLength": 1
                      },
                      "scope": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ]
                        }
                      },
                      "manifestHash": {
                        "type": "string",
                        "minLength": 1
                      },
                      "disabled": {
                        "type": "boolean"
                      },
                      "person": {
                        "type": "string",
                        "minLength": 1
                      },
                      "grantedAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      },
                      "stale": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "consumer",
                      "account",
                      "scope",
                      "manifestHash",
                      "disabled",
                      "person",
                      "grantedAt"
                    ],
                    "additionalProperties": false,
                    "description": "One grant behind a source or an action, and the binding the person consented to."
                  }
                }
              },
              "required": [
                "id",
                "preview",
                "commit",
                "operations",
                "confirmation",
                "grants"
              ],
              "additionalProperties": false
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "class": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write",
                    "send",
                    "share",
                    "delete",
                    "export",
                    "admin"
                  ]
                },
                "effect": {
                  "type": "string",
                  "enum": [
                    "ask",
                    "deny"
                  ]
                },
                "access": {
                  "type": "string",
                  "enum": [
                    "runs",
                    "asks first",
                    "off"
                  ]
                }
              },
              "required": [
                "method",
                "class",
                "access"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "package",
          "version",
          "manifestHash",
          "access",
          "sources",
          "actions",
          "methods"
        ],
        "additionalProperties": false
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "grant": {
            "type": "object",
            "properties": {
              "consumer": {
                "type": "string",
                "minLength": 1
              },
              "account": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "manifestHash": {
                "type": "string",
                "minLength": 1
              },
              "disabled": {
                "type": "boolean"
              },
              "person": {
                "type": "string",
                "minLength": 1
              },
              "grantedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "stale": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "consumer",
              "account",
              "scope",
              "manifestHash",
              "disabled",
              "person",
              "grantedAt"
            ],
            "additionalProperties": false,
            "description": "One grant behind a source or an action, and the binding the person consented to."
          }
        },
        "required": [
          "problem",
          "grant"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "person",
    "plugins",
    "problems"
  ],
  "additionalProperties": false,
  "description": "What each installed plugin may read and do for one person, and the grant behind each declaration."
}
