{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "commitment"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "A stable id of this commitment within the source and account."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "description": "An actor id on the same event."
    },
    "counterparty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320,
      "description": "An actor id on the same event."
    },
    "due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "cancelled"
      ]
    },
    "url": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "required": [
    "type",
    "key",
    "title",
    "owner",
    "state"
  ],
  "additionalProperties": false
}
