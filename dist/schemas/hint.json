{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "description": "One of the plugin's own source ids."
    },
    "kinds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "produces": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "commitment",
          "person.attribute",
          "meeting.attended"
        ]
      }
    }
  },
  "required": [
    "source",
    "kinds"
  ],
  "additionalProperties": false
}
