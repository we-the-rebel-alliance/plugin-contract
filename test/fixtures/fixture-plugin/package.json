{
  "name": "@we-the-rebel-alliance/fixture-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Conformance fixture: a real OpenCode plugin used by the kit's own tests.",
  "exports": {
    "./server": "./index.js"
  },
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "fixture",
      "title": "Fixture",
      "summary": "A fixture plugin for the conformance kit, with reads, writes and an action.",
      "vendor": { "id": "fixture", "name": "Fixture", "domain": "fixture.example" },
      "icons": [{ "src": "assets/icon.svg", "type": "image/svg+xml" }],
      "host": { "opencode": ">=2.4.1 <2.5.0", "tested": ["2.4.1"] }
    },
    "accounts": {
      "via": "integration",
      "profile": { "$ref": "#/options/properties/accounts/additionalProperties" },
      "owner": "mailto"
    },
    "options": {
      "type": "object",
      "properties": {
        "access": { "type": "string", "enum": ["all", "ask-changes", "read-only"], "default": "all", "description": "How much the plugin's methods may do." },
        "accounts": {
          "type": "object",
          "description": "One profile per account alias.",
          "additionalProperties": {
            "type": "object",
            "properties": { "region": { "type": "string", "description": "The provider region." } },
            "additionalProperties": false
          }
        },
        "allowUntestedHost": { "type": "boolean", "default": false, "description": "Start outside the tested OpenCode range." }
      },
      "additionalProperties": false
    },
    "methods": {
      "status": {
        "class": "read",
        "description": "Read the fixture's status.",
        "input": { "type": "object", "properties": {}, "additionalProperties": false },
        "accounts": "none"
      },
      "probe": { "class": "read", "accounts": "optional", "operations": ["fixture.users.get"] },
      "events_list": {
        "class": "read",
        "description": "List fixture messages.",
        "input": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "cursor": { "type": "string" },
            "thumbnails": { "type": "boolean" },
            "scope": { "type": "object", "additionalProperties": true },
            "account": { "type": "string", "description": "The account alias, such as work; omit it when the plugin has one account." }
          },
          "additionalProperties": false
        },
        "accounts": "optional",
        "operations": ["fixture.messages.list", "fixture.users.get"]
      },
      "read_message": { "class": "read", "accounts": "optional", "operations": ["fixture.messages.get"] },
      "list_channels": { "class": "read", "accounts": "optional", "operations": ["fixture.channels.list"] },
      "plan_send": { "class": "read", "plans": true, "accounts": "optional", "operations": ["fixture.messages.create"] },
      "send_message": {
        "class": "send",
        "commits": "plan_send",
        "description": "Send a planned message.",
        "input": {
          "type": "object",
          "properties": { "planId": { "type": "string", "minLength": 1 } },
          "required": ["planId"],
          "additionalProperties": false
        },
        "accounts": "optional",
        "operations": ["fixture.messages.create"]
      },
      "write_note": { "class": "write", "accounts": "optional", "operations": ["fixture.notes.create"] },
      "delete_note": { "class": "delete", "accounts": "optional", "operations": ["fixture.notes.delete"] },
      "share_note": { "class": "share", "accounts": "optional", "operations": ["fixture.notes.share"] },
      "pinned_status": { "class": "read", "accounts": "none", "pinned": true },
      "mcp:list_files": { "class": "read" }
    },
    "sources": [
      {
        "id": "fixture.messages",
        "kind": "events",
        "reads": "message",
        "method": "events_list",
        "input": { "source": "messages" },
        "service": { "id": "fixture.messages", "label": "Messages" },
        "operations": ["fixture.messages.list", "fixture.users.get"],
        "scope": {
          "keys": ["channels"],
          "describe": "Channels to read.",
          "suggest": { "method": "list_channels", "operations": ["fixture.channels.list"] }
        },
        "cadence": { "suggestMinutes": 1 },
        "signals": ["bus"],
        "private": true,
        "cost": { "class": "free" },
        "maxBytes": 65536,
        "details": [{ "id": "fixture.messages.message", "method": "read_message", "from": ["external_id"] }],
        "urlHosts": ["files.example.com"],
        "thumbnails": true
      }
    ],
    "actions": [
      {
        "id": "fixture.messages.send",
        "effect": "notify",
        "preview": "plan_send",
        "commit": "send_message",
        "input": { "type": "object", "additionalProperties": true },
        "output": { "type": "object", "additionalProperties": true }
      }
    ],
    "events": { "changed": {}, "status": {}, "account": {} }
  }
}
