{
  "name": "@we-the-rebel-alliance/slack-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Example: the Slack plugin's workspace source as the contract declares it. Every person, id and message is invented.",
  "exports": {
    "./server": "./index.js"
  },
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "slack",
      "title": "Slack",
      "summary": "Channels, threads and direct messages as contract events.",
      "vendor": { "id": "slack", "name": "Slack", "domain": "slack.com" },
      "icons": [{ "src": "assets/icon.svg", "type": "image/svg+xml" }],
      "host": { "opencode": ">=2.4.1 <2.5.0", "tested": ["2.4.1"] }
    },
    "accounts": {
      "via": "mcp",
      "profile": { "$ref": "#/options/properties/accounts/additionalProperties" },
      "owner": "slack"
    },
    "options": {
      "type": "object",
      "properties": {
        "access": { "type": "string", "enum": ["all", "ask-changes", "read-only"], "default": "all", "description": "How much the plugin's methods may do." },
        "accounts": {
          "type": "object",
          "description": "One profile per account alias.",
          "additionalProperties": {
            "type": "object",
            "properties": { "workspace": { "type": "string", "description": "The workspace host, such as example.slack.com." } },
            "additionalProperties": false
          }
        },
        "allowUntestedHost": { "type": "boolean", "default": false, "description": "Start outside the tested OpenCode range." }
      },
      "additionalProperties": false
    },
    "methods": {
      "status": { "class": "read", "accounts": "none" },
      "probe": { "class": "read", "accounts": "optional", "operations": ["slack_read_user_profile"] },
      "events_list": { "class": "read", "accounts": "optional", "operations": ["slack_read_user_profile", "slack_read_channel", "slack_read_thread"] },
      "read_thread": { "class": "read", "accounts": "optional", "operations": ["slack_read_thread"] },
      "list_user_channels": { "class": "read", "accounts": "optional", "operations": ["slack_list_user_channels"] }
    },
    "sources": [
      {
        "id": "slack.workspace",
        "kind": "events",
        "reads": "message",
        "method": "events_list",
        "input": { "source": "slack" },
        "service": { "id": "slack.workspace", "label": "Workspace" },
        "operations": ["slack_read_user_profile", "slack_read_channel", "slack_read_thread"],
        "scope": {
          "keys": ["channels"],
          "describe": "Channels and direct messages to read.",
          "suggest": { "method": "list_user_channels", "operations": ["slack_list_user_channels"] }
        },
        "cadence": { "suggestMinutes": 1 },
        "signals": ["bus"],
        "private": true,
        "cost": { "class": "free" },
        "maxBytes": 262144,
        "details": [{ "id": "slack.workspace.thread", "method": "read_thread", "from": ["thread"] }],
        "urlHosts": ["*.slack.com"]
      }
    ],
    "actions": [],
    "events": { "changed": {} }
  }
}
