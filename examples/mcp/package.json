{
  "name": "@we-the-rebel-alliance/trellis-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Example: a chat service with two accounts held by the mcp mechanism and the vendor's MCP tools passed through. Every person, channel and message is invented.",
  "exports": {
    "./server": "./index.js"
  },
  "capabilities": {
    "version": 1,
    "plugin": {
      "name": "trellis",
      "title": "Trellis",
      "summary": "Channels, threads and direct messages from Trellis, with the vendor's MCP tools passed through.",
      "vendor": { "id": "trellis", "name": "Trellis", "domain": "trellis.example.com" },
      "icons": [{ "src": "assets/icon.svg", "type": "image/svg+xml" }],
      "host": { "opencode": ">=2.4.1 <2.5.0", "tested": ["2.4.1"] }
    },
    "accounts": {
      "via": "mcp",
      "profile": { "$ref": "#/options/properties/accounts/additionalProperties" },
      "owner": "trellis"
    },
    "options": {
      "type": "object",
      "properties": {
        "access": { "type": "string", "enum": ["all", "ask-changes", "read-only"], "default": "all", "description": "How much the plugin's methods may do." },
        "accounts": {
          "type": "object",
          "description": "One profile per account alias.",
          "additionalProperties": {
            "type": "object",
            "properties": { "workspace": { "type": "string", "description": "The Trellis workspace this alias reads." } },
            "additionalProperties": false
          }
        },
        "allowUntestedHost": { "type": "boolean", "default": false, "description": "Start outside the tested OpenCode range." }
      },
      "additionalProperties": false
    },
    "methods": {
      "status": { "class": "read", "accounts": "optional" },
      "probe": { "class": "read", "accounts": "optional", "operations": ["trellis.users.get"] },
      "events_list": { "class": "read", "accounts": "optional", "operations": ["trellis.users.get", "messages_search", "messages_read"] },
      "read_thread": { "class": "read", "accounts": "optional", "operations": ["trellis.users.get", "messages_read"] },
      "list_channels": { "class": "read", "accounts": "optional", "operations": ["trellis.channels.list"] },
      "mcp:*": { "class": "read", "operations": ["messages_search", "messages_read"] }
    },
    "sources": [
      {
        "id": "trellis.messages",
        "kind": "events",
        "reads": "message",
        "method": "events_list",
        "input": { "source": "messages" },
        "service": { "id": "trellis.messages", "label": "Messages" },
        "operations": ["trellis.users.get", "messages_search", "messages_read"],
        "scope": {
          "keys": ["channels"],
          "describe": "The channels and direct messages to read.",
          "suggest": { "method": "list_channels", "operations": ["trellis.channels.list"] }
        },
        "cadence": { "suggestMinutes": 2 },
        "signals": ["bus"],
        "private": true,
        "cost": { "class": "free" },
        "maxBytes": 262144,
        "details": [{ "id": "trellis.messages.thread", "method": "read_thread", "from": ["thread"] }],
        "urlHosts": ["app.trellis.example.com"]
      }
    ],
    "actions": [],
    "events": {}
  }
}
